# 复制为 .env 并填入凭证（.env 不进 git）
# 主模型：MiniMax-M3（Anthropic 兼容端点）
MINIMAX_BASE_URL=https://api.minimax.cn/anthropic
MINIMAX_API_KEY=

# 备用/降级：GLM（火山方舟 coding 端点，Anthropic 兼容）
GLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
GLM_API_KEY=

# —— 数据库（config/database.yaml 占位符消费；不填用开发默认＝compose 本地 PG@5433）——
# PG_HOST=localhost
# PG_PORT=5433
# PG_DB=petro
# PG_USER=petro
# PG_PASSWORD=petro

# —— SM4 字段加密密钥（hex 32 位＝16 字节；infra.crypto/EncryptedField 消费）——
