data: {"index": 14, "source": "《B-渤中34-5油田躺井治理与检泵作业月报-202608》", "content": "4.3 其他案例摘要W-23 井固定阀凡尔球点蚀（产出液 CO₂ 腐蚀，点蚀坑 0.6 毫米），更换整体泵并加注缓蚀棒；W-31 井泵筒磨大，检查发现沉砂口袋砂面上升 42 米，配套调整洗井周期由 90 天缩短至 60 天。━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━", "trust": "report"}

