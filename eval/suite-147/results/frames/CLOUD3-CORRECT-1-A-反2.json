³/d（地面原油密度 0.865 t/m³，折算约 334 吨/日），生产压差 1.85 MPa，采油指数 208.6 m³/(d·MPa)，与邻井 W-09 井初期产能相当。表皮系数反演预计 −2.0～−1.0（射孔与防砂联合见效，未见明显污染）。含水 0.5%，属残余水携带。油田开发部意见：W-11 井按 12 mm 油嘴制度纳入三季度生产组织，两周后视含水与动液面复测结果再评估工作制度。━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━", "trust": "report"}}, {"event": "observation", "data": {"index": 2, "source": "《A-W11井完井工程报告》", "content": "〔节级摘要｜《A-W11井完井工程报告》·章节 02 第二章 钻井液与完井液｜覆盖 3 支切片〕A-W11井各阶段钻井液性能分段控制：一开密度1.05 g/cm³；二开钻进段1.08 g/cm³，穿明下段泥岩段提至1.12 g/cm³稳定井壁；三开完井段置换为清洁盐水完井液，密度1.05 g/cm³，对应油层压力系数0.92，保持微正压0.35 MPa近平衡。漏斗粘度45～58 s，API失水3.8～4.6 mL，pH 9.0～9.5，含砂≤0.2%。完井液配方为过滤海水+KCl 3%+缓蚀剂0.3%+防膨剂1.5%，含油量＜10 mg/L，固体粒径中值＜2 μm，整池置换后循环两周，每4小时检测密度与失水，性能稳定达标。", "trust": "report"}}, {"event": "observation", "data": {"index": 3, "source": "《Y-21井完井工程报告》", "content": "〔节级摘要｜《Y-21井完井工程报告》·章节 02 第二章 钻井液与完井液｜覆盖 3 支切片〕各开次钻井液性能：一开密度1.05 g/cm³，漏斗粘度45～55 s；二开1.10/52 s、API失水4.8 mL；三开1.12/54 s/4.0 mL；四开尾管1.08/50 s/3.8 mL；完井段1.02/46 s/3.6 mL，含砂均≤0.2%，pH 9.0～9.5。四开钻穿Es2油层前实测地层压力27.16 MPa（油层中深2826 m，压力系数0.98），据此确定完井段密度1.02 g/cm³，液柱压力28.28 MPa，实现微正压近平衡，储层裸露期无油气侵与井漏。完井液采用过滤海水+KCl 3%+缓蚀剂0.3%+防膨剂2.0%，含油量<10 mg/L、颗粒粒径<2 μm，整池置换340 m³后循环两周，每4小时检测密度与失水。", "trust": "report"}}, {"event": "observation", "data": {"index": 4, "source": "《渤中34-8油田一季度注采调整与生产运行分析》", "content": "〔节级摘要｜《渤中34-8油田一季度注采调整与生产运行分析》·章节 01 一、一季度生产运行｜覆盖 4 支切片〕一季度月开井37～39口，平均日产油689 m³/d，季度产油5.52万吨（日历折算主口径），完成率98.6%；剔检口径5.67万吨、101.2%，差值由4井次电泵检泵（Y-23/Y-27/Y-31/Y-35，合计31井日、影响1490吨）所致。综合含水率稳定79.2%～79.3%，3月油压回升0.2 MPa与月注采比站上1.0同步；Y-59井3月1日投产、Y-31检泵周期287天偏短列入复查；抽油机时率94.1%。", "trust": "report"}}, {"event": "observation", "data": {"index": 5, "source": "《C-渤中34-5油田三季度注水调整与生产运行分析》", "content": "四、措施效果评价━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━W-33 井酸化增油（本季度唯一油井措施）：8 月 12 日施工，解堵酸化 20 m³。施工后日产油由 28 m³/d 升至 41 m³/d，日增 13 m³/d，含水稳定无突升。预计有效期 90 天（至 11 月上旬），截至 9 月 30 日累计增油 551 吨。按措施总投入 46 万元、预计满期总增油 1012 吨（1170 m³，折桶系数 6.29 桶/m³）计算，桶油增产成本约 63 元/桶，远低于油田措施门槛值 480 元/桶，评价为有效且经济性显著。措施有效率与有效期台账口径提示：本季度油井措施 1 井次，待有效期到达后按台账口径（有效井次 ÷ 总井次；有效期 t₂−t₁）正式登记。━━━━