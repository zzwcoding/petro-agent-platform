{
  "version": "1.2.0",
  "description": "类型层依赖白名单（ref 字段粒度，AC4/AC5 判定真源）。idPrefixes=ID 前缀→模型（前缀即类型标签）；refKeys=ref 语义字段名全集（扫描时与 xxxRef/xxxRefs 后缀规则取并集）；edges=from 模型 × ref 字段 → 允许目标模型集。未登记 edges 的 ref 字段按 model-registry.json 该模型 dependsOn 兜底判定；闸同时核对 edges 与 dependsOn 不冲突。消费方：tools/schema_check.py。与 model-registry.json 保持一致（schema.md §13）。版本演进账见 ontology/schema/CHANGELOG.md。",
  "idPrefixes": {
    "AGG-": "M1",
    "ASSOC-": "M1",
    "DICT-": "M1",
    "BH-": "M2",
    "RULE-": "M3",
    "ACTOR-": "M5",
    "ROLE-": "M5",
    "PERM-": "M5",
    "FLOW-": "M6",
    "QR-": "M7",
    "RPT-": "M7",
    "SCR-": "MU",
    "GLS-": "GLS"
  },
  "refKeys": [
    "ownerEntity",
    "appliedRules",
    "requiredPermissions",
    "inheritsFrom",
    "roles",
    "permissions",
    "targetAggregate",
    "sourceAggregate",
    "dictionaryId",
    "dataSource",
    "relatedObjectRefs"
  ],
  "edges": [
    { "from": "M1", "field": "targetAggregate", "to": ["M1"] },
    { "from": "M1", "field": "sourceAggregate", "to": ["M1"] },
    { "from": "M1", "field": "dictionaryId", "to": ["M1"] },
    { "from": "M2", "field": "ownerEntity", "to": ["M1"] },
    { "from": "M2", "field": "appliedRules", "to": ["M3"] },
    { "from": "M2", "field": "requiredPermissions", "to": ["M5"] },
    { "from": "M2", "field": "ruleRef", "to": ["M3"] },
    { "from": "M2", "field": "behaviorRef", "to": ["M2"] },
    { "from": "M3", "field": "reusedBy", "to": ["M2"] },
    { "from": "M3", "field": "behaviorRef", "to": ["M2"] },
    { "from": "M5", "field": "roles", "to": ["M5"] },
    { "from": "M5", "field": "permissions", "to": ["M5"] },
    { "from": "M5", "field": "inheritsFrom", "to": ["M5"] },
    { "from": "M5", "field": "targetRef", "to": ["M1", "M2"] },
    { "from": "M6", "field": "businessObjectRefs", "to": ["M1"] },
    { "from": "M6", "field": "roleRefs", "to": ["M5"] },
    { "from": "M6", "field": "roleRef", "to": ["M5"] },
    { "from": "M6", "field": "behaviorRef", "to": ["M2"] },
    { "from": "M6", "field": "ruleRef", "to": ["M3"] },
    { "from": "M6", "field": "subFlowRef", "to": ["M6"] },
    { "from": "M7", "field": "behaviorRef", "to": ["M2"] },
    { "from": "M7", "field": "objectRef", "to": ["M1"] },
    { "from": "MU", "field": "screenRef", "to": ["MU"] },
    { "from": "MU", "field": "behaviorRef", "to": ["M2"] },
    { "from": "MU", "field": "permissionRef", "to": ["M5"] },
    { "from": "MU", "field": "dataSource", "to": ["M7"] },
    { "from": "GLS", "field": "relatedObjectRefs", "to": ["M1"] }
  ]
}
